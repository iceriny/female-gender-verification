# 开发者密钥（必填，用于解锁参考答案 / 内置 API Key）
VITE_DEV_SECRET=your_secret_here
VITE_DEV_SECRET_SALT=your_salt_here

# 内置 LLM API Key（可选，填写后部署版本支持通过开发者密钥解锁使用）
# VITE_LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 内置 OpenRouter API Key（可选，填写后部署版本支持通过开发者密钥解锁使用）
# VITE_OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Debug 模式（可选，开发环境默认 true，生产环境默认 false）
# VITE_DEBUG=false
